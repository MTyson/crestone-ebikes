# Supabase (leave blank to run the interactive prototype with localStorage)
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" key ONLY. Never put the service_role key in this app.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional donation link (Stripe Payment Link, Venmo, etc.)
VITE_DONATION_URL=
